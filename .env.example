# Copy to .env.local and fill in real values. Never commit .env.local.

# --- Supabase (DB + Auth) ---
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=

# --- LLM providers (AIProvider implementations) ---
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# --- Speech-to-text (evaluate puter.js vs provider fallback) ---
PUTER_JS_ENABLED=false

# --- Email ---
RESEND_API_KEY=

# --- Deployment ---
VERCEL_TOKEN=
RENDER_TOKEN=

# --- Search (self-hosted, no key needed) ---
SEARXNG_BASE_URL=http://localhost:8080
